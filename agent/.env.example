# ── AI 卧底进程配置 ──────────────────────────────────────────
# 复制为 agent/.env 后再填自己的值：
#     cp agent/.env.example agent/.env
#
# AI 必须有自己独立的一把钥：既不是玩家钥，也不是部署钥。
# 它只用来给 AI 座位签名；进程永远不读取任何玩家私钥。
# ⚠️ 本文件只放占位符，不要把真实 API Key / 私钥写进来。

# 本地演示可直接用 Anvil 1 号测试钥（仅限 chainId 31337）：
# AGENT_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# 公网：换成只有你持有的钥（需有 MON）。脚本会拒绝在非本地链上使用公开测试钥。
# AGENT_KEY=0x...
#
# ── 测试网常驻示例（Monad 10143）──────────────────────────────
# CHAIN_ID=10143
# RPC_URL=https://testnet-rpc.monad.xyz
# AGENT_KEY=0x<your-funded-key>
# AGENT_SEAT=2
# 前端创建房间后，本进程会 registerAgent → 自动入座空着的 AGENT_SEAT → 轮询走子。
# 地址文件：frontend/src/lib/addresses.10143.json（或设 VITE_GAMETABLE 等）

# ── Kimi（Moonshot）大模型：选棋 + 走路 + 说话 + 背刺 ───────
# 已接入 agent/src/kimi.ts：合法着由规则引擎列出，模型只选 index。
# 控制台：https://platform.moonshot.cn/console/api-keys
# OpenAI 兼容接口；真实 key 只写在 agent/.env，勿提交仓库。
# 未填则自动用脚本 pickAiMove。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# 能力开关（默认全开；关掉某项则回退本地脚本策略）
# KIMI_ENABLE_MOVE=1           从合法着列表里选棋（坐标仍由规则引擎校验）
# KIMI_ENABLE_WALK=1           生成走法解说 / 着法叙述（如「马二进三」风格旁白）
# KIMI_ENABLE_SPEECH=1         对局中说话：嘲讽、结盟话术、油费施压
# KIMI_ENABLE_BETRAYAL=1       到点后策划并执行背刺（优先吃盟友士 → Slash）
# KIMI_FALLBACK_SCRIPT=1       模型失败/超时则回退 pickAiMove 脚本

# 背刺与座位
# AGENT_SEAT=2                 AI 坐哪一座（默认 2 = 绿营）
# BETRAYAL_AFTER_PLIES=10      接盟后履约多少手开始背刺
# ALLY_SEAT=0                  假诚意盟友座位（演示默认红营）

# 运行
# AGENT_POLL_MS=1500           轮询间隔
# KIMI_TIMEOUT_MS=12000        单次调用超时
# GAME_ID=                     只服务指定对局；不填则自动接管
# RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337
