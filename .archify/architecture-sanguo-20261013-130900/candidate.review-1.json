  "cards": [
    {
      "dot": "emerald",
      "title": "主要用户旅程",
      "items": [
        "浏览器钱包连 Vercel 前端，私钥不出钱包",
        "走子一步一签，直接落到 GameTable",
        "结盟走 Covenant 诚意金，背刺由 challengeBetrayal 罚没"
      ]
    },
    {
      "dot": "cyan",
      "title": "读侧为什么绕一圈",
      "items": [
        "链上没有「列出所有对局」的接口",
        "索引器只读扫描事件，写进 Supabase",
        "前端读排行榜与历史走索引器，不直连数据库"
      ]
    },
    {
      "dot": "violet",
      "title": "卧底的两层",
      "items": [
        "连接组：确定性本能，同一局面永远算出同一冲动",
        "Kimi：把冲动变成台词与自我合理化",
        "连接组只出行为倾向，不直接选棋着"
      ]
    },
    {
      "dot": "amber",
      "title": "读数据时必须注意",
      "items": [
        "合约重新部署地址就变，而 gameId 从 1 重来",
        "所以 games 表带 contract 列，读接口按当前合约过滤",
        "否则旧部署的幽灵对局会一直留在榜上"
      ]
    }
  ]
