{
  "name": "sanguo-xiangqi",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build:shared": "pnpm --filter @sanguo/shared build",
    "test:shared": "pnpm --filter @sanguo/shared test",
    "test:forge": "cd contracts && forge test",
    "anvil": "anvil --chain-id 31337 --block-time 1",
    "deploy:local": "bash scripts/deploy-local.sh",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "demo": "pnpm --filter @sanguo/shared build && tsx scripts/demo-harness.ts"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "@sanguo/shared": "workspace:*",
    "tsx": "^4.20.5",
    "viem": "^2.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
