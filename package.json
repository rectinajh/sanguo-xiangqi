{
  "name": "sanguo-xiangqi",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build:shared": "pnpm --filter @sanguo/shared build",
    "test:shared": "pnpm --filter @sanguo/shared test",
    "test:forge": "cd contracts && FOUNDRY_PROFILE=test forge test",
    "anvil": "anvil --chain-id 31337 --block-time 1 --code-size-limit 500000 --gas-limit 100000000",
    "deploy:local": "bash scripts/deploy-local.sh",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "demo": "pnpm --filter @sanguo/shared build && tsx scripts/demo-harness.ts",
    "agent": "pnpm --filter @sanguo/shared build && pnpm --filter agent start",
    "agent:dev": "pnpm --filter agent start",
    "typecheck": "tsc --noEmit -p tsconfig.json && cd frontend && tsc -b --force && cd ../agent && tsc --noEmit && cd ../server && tsc --noEmit",
    "test:frontend": "pnpm --filter frontend test",
    "gen:sanren": "tsx scripts/gen-sanren-solidity.ts",
    "test": "pnpm test:shared && pnpm --filter frontend test && pnpm test:forge && pnpm size",
    "indexer": "pnpm --filter server indexer",
    "indexer:once": "pnpm --filter server indexer:once",
    "size": "bash scripts/check-size.sh"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "@sanguo/shared": "workspace:*",
    "tsx": "^4.20.5",
    "viem": "^2.21.0",
    "@types/node": "^22.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "tinypool": ">=2.1.2",
      "esbuild": "^0.25.12"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
