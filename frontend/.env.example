# ── 前端构建期配置（可选）──────────────────────────────────────
# 不设置时，前端会读取 src/lib/addresses.json（由 deploy:local /
# deploy:testnet 写入）。要把测试网地址固化进产物，就复制本文件为
# frontend/.env 并填好下面几项。
#
# ⚠️ 这些值会被打进前端 bundle，属于公开信息 —— 只填地址，永远不要填私钥。

# VITE_CHAIN_ID=10143
# VITE_RPC_URL=https://testnet-rpc.monad.xyz
# 也可不填下面四项，直接用 src/lib/addresses.10143.json（deploy:testnet 写入）
# VITE_GAMETABLE=0x808a1e24d13681e4666706d60def28afe21859af
# VITE_COVENANT=0x857ff987f28564b7f7b6a58cd421bd4e01ec80b9
# VITE_AGENTREGISTRY=0x9c19c6213dc150c9fe38a20fae0721bd9935c012
# VITE_STUBVERIFIER=0xc0ff952f5679c877a1bd4cabdf9b2348e3d3b333

# 水龙头服务地址（服务端进程，见 server/）。不填则默认 http://127.0.0.1:8787
# VITE_FAUCET_URL=https://faucet.monad.xyz   （默认就是官方水龙头，一般不用改）

# 索引器服务地址（服务端进程，见 server/src/indexer.ts）。
# 不填则默认 http://127.0.0.1:8788
# VITE_INDEXER_URL=https://indexer.your-domain.com
